from datetime import date

import pytest

from personal_finance_analytics_system.transaction import Transaction


def test_transaction_accepts_valid_date() -> None:
    """Accept a valid transaction date"""
    transaction = Transaction(
        amount=500,
        transaction_type="expense",
        category="Food",
        description="Lunch",
        transaction_date="2026-07-22",
    )

    assert transaction.transaction_date == "2026-07-22"


def test_transaction_uses_today_by_default() -> None:
    """Use today when no date is provided"""
    transaction = Transaction(
        amount=500,
        transaction_type="expense",
        category="Food",
    )

    assert transaction.transaction_date == date.today().isoformat()


def test_transaction_rejects_invalid_date() -> None:
    """Reject an invalid transaction date"""
    with pytest.raises(
        ValueError,
        match="Date must use YYYY-MM-DD format",
    ):
        Transaction(
            amount=500,
            transaction_type="expense",
            category="Food",
            transaction_date="22-07-2026",
        )